---
const steps = [
  {
    number: '01',
    title: 'Install',
    description: 'One command deploys the whole platform — Operator, API, UI and a database — to your cluster.',
    code: `curl -fsSL https://getvesta.sh/install.sh | sh`,
  },
  {
    number: '02',
    title: 'Push',
    description: 'Build straight from a git branch, or ship a pre-built image. One command, no YAML.',
    code: `vesta build my-app --environment production --branch main`,
  },
  {
    number: '03',
    title: 'Live',
    description: 'Your app is running with automatic ingress, TLS, health checks, and autoscaling. Done.',
    code: `✓ Build succeeded — my-app:7f3c9a1
✓ Deployed to production

  Replicas:     2/2 ready
  Ingress:      my-app.apps.getvesta.sh
  TLS:          letsencrypt-prod
  Autoscaling:  2-10 pods (CPU > 70%)`,
  },
];
---

<section class="relative py-24 lg:py-32 overflow-hidden">
  <!-- Ambient -->
  <div class="absolute left-1/2 top-0 bottom-0 w-px bg-gradient-to-b from-transparent via-border to-transparent hidden lg:block"></div>

  <div class="max-w-6xl mx-auto px-6">
    <div class="text-center mb-20 reveal">
      <span class="text-[11px] font-mono font-semibold text-accent uppercase tracking-[0.15em] mb-4 block">How it works</span>
      <h2 class="font-display italic text-4xl md:text-5xl text-text-primary">
        Three commands. That's it.
      </h2>
    </div>

    <div class="space-y-16 lg:space-y-24">
      {steps.map((step, i) => (
        <div class:list={[
          'reveal grid lg:grid-cols-2 gap-8 lg:gap-16 items-center',
        ]} style={`transition-delay: ${i * 100}ms`}>
          <!-- Text -->
          <div class:list={[i % 2 === 1 && 'lg:order-2']}>
            <div class="flex items-center gap-4 mb-4">
              <span class="font-mono text-sm text-accent/60">{step.number}</span>
              <div class="h-px flex-1 bg-gradient-to-r from-accent/20 to-transparent"></div>
            </div>
            <h3 class="font-display italic text-3xl text-text-primary mb-3">{step.title}</h3>
            <p class="text-text-secondary leading-relaxed">{step.description}</p>
          </div>

          <!-- Code block -->
          <div class:list={[i % 2 === 1 && 'lg:order-1']}>
            <div class="relative rounded-xl border border-border bg-surface-1/90 overflow-hidden group">
              <div class="flex items-center justify-between px-4 py-2.5 border-b border-border/50 bg-surface-2/30">
                <div class="flex items-center gap-2">
                  <div class="w-2 h-2 rounded-full bg-accent/40"></div>
                  <span class="text-[11px] font-mono text-text-tertiary">terminal</span>
                </div>
                <button
                  class="copy-btn text-[11px] font-mono text-text-tertiary hover:text-accent transition-colors"
                  data-code={step.code}
                >
                  copy
                </button>
              </div>
              <pre class="p-4 overflow-x-auto"><code class="font-mono text-[13px] text-text-primary leading-relaxed">{step.code}</code></pre>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
