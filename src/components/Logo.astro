---
const { class: className } = Astro.props;
---

<a href="/" class:list={["flex items-center gap-2.5 group", className]}>
  <div class="relative w-8 h-8 rounded-lg bg-gradient-to-br from-accent/20 to-accent/5 border border-accent/30 flex items-center justify-center group-hover:border-accent/50 transition-colors">
    <div class="w-3 h-3 rounded-sm bg-accent shadow-[0_0_12px_rgba(245,158,11,0.4)]"></div>
  </div>
  <div class="flex items-baseline gap-1.5">
    <span class="font-display italic text-xl text-text-primary tracking-tight">Vesta</span>
  </div>
</a>
