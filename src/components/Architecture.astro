---
const components = [
  {
    name: 'Operator',
    tech: 'Go / Kubebuilder',
    description: 'Watches CRDs and reconciles Deployments, Services, Ingress, HPA, and Secrets.',
    icon: `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M9.594 3.94c.09-.542.56-.94 1.11-.94h2.593c.55 0 1.02.398 1.11.94l.213 1.281c.063.374.313.686.645.87.074.04.147.083.22.127.324.196.72.257 1.075.124l1.217-.456a1.125 1.125 0 011.37.49l1.296 2.247a1.125 1.125 0 01-.26 1.431l-1.003.827c-.293.24-.438.613-.431.992a6.759 6.759 0 010 .255c-.007.378.138.75.43.99l1.005.828c.424.35.534.954.26 1.43l-1.298 2.247a1.125 1.125 0 01-1.369.491l-1.217-.456c-.355-.133-.75-.072-1.076.124a6.57 6.57 0 01-.22.128c-.331.183-.581.495-.644.869l-.213 1.28c-.09.543-.56.941-1.11.941h-2.594c-.55 0-1.02-.398-1.11-.94l-.213-1.281c-.062-.374-.312-.686-.644-.87a6.52 6.52 0 01-.22-.127c-.325-.196-.72-.257-1.076-.124l-1.217.456a1.125 1.125 0 01-1.369-.49l-1.297-2.247a1.125 1.125 0 01.26-1.431l1.004-.827c.292-.24.437-.613.43-.992a6.932 6.932 0 010-.255c.007-.378-.138-.75-.43-.99l-1.004-.828a1.125 1.125 0 01-.26-1.43l1.297-2.247a1.125 1.125 0 011.37-.491l1.216.456c.356.133.751.072 1.076-.124.072-.044.146-.087.22-.128.332-.183.582-.495.644-.869l.214-1.281z" /><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /></svg>`,
    position: 'top-left',
  },
  {
    name: 'API Server',
    tech: 'Go / Gin',
    description: 'REST API for projects, apps, deployments, secrets, auth, and notifications.',
    icon: `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M5.25 14.25h13.5m-13.5 0a3 3 0 01-3-3m3 3a3 3 0 100 6h13.5a3 3 0 100-6m-16.5-3a3 3 0 013-3h13.5a3 3 0 013 3m-19.5 0a4.5 4.5 0 01.9-2.7L5.737 5.1a3.375 3.375 0 012.7-1.35h7.126c1.062 0 2.062.5 2.7 1.35l2.587 3.45a4.5 4.5 0 01.9 2.7m0 0a3 3 0 01-3 3m0 3h.008v.008h-.008v-.008zm0-6h.008v.008h-.008v-.008zm-3 6h.008v.008h-.008v-.008zm0-6h.008v.008h-.008v-.008z" /></svg>`,
    position: 'top-right',
  },
  {
    name: 'Web UI',
    tech: 'React / TypeScript',
    description: 'Dashboard for managing the platform — projects, apps, secrets, and deployments.',
    icon: `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M9 17.25v1.007a3 3 0 01-.879 2.122L7.5 21h9l-.621-.621A3 3 0 0115 18.257V17.25m6-12V15a2.25 2.25 0 01-2.25 2.25H5.25A2.25 2.25 0 013 15V5.25m18 0A2.25 2.25 0 0018.75 3H5.25A2.25 2.25 0 003 5.25m18 0V12a2.25 2.25 0 01-2.25 2.25H5.25A2.25 2.25 0 013 12V5.25" /></svg>`,
    position: 'bottom-left',
  },
  {
    name: 'CLI',
    tech: 'Go / Cobra',
    description: 'Command-line tool for all operations — deploys, secrets, projects, and more.',
    icon: `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m6.75 7.5 3 2.25-3 2.25m4.5 0h3m-9 8.25h13.5A2.25 2.25 0 0 0 21 18V6a2.25 2.25 0 0 0-2.25-2.25H5.25A2.25 2.25 0 0 0 3 6v12a2.25 2.25 0 0 0 2.25 2.25Z" /></svg>`,
    position: 'bottom-right',
  },
];
---

<section class="relative py-24 lg:py-32 bg-surface-1/20">
  <div class="max-w-6xl mx-auto px-6">
    <div class="text-center mb-16 reveal">
      <span class="text-[11px] font-mono font-semibold text-accent uppercase tracking-[0.15em] mb-4 block">Architecture</span>
      <h2 class="font-display italic text-4xl md:text-5xl text-text-primary mb-4">
        Four components.<br />One platform.
      </h2>
      <p class="text-text-secondary text-lg max-w-2xl mx-auto">
        Each component is independently deployable and follows Kubernetes-native patterns.
      </p>
    </div>

    <!-- Architecture grid -->
    <div class="relative">
      <!-- Center connection hub -->
      <div class="hidden lg:flex absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 z-10">
        <div class="w-16 h-16 rounded-2xl bg-surface-2 border border-accent/20 flex items-center justify-center shadow-glow animate-border-glow">
          <div class="w-4 h-4 rounded bg-accent shadow-[0_0_20px_rgba(245,158,11,0.5)]"></div>
        </div>
      </div>

      <!-- Connection lines (decorative) -->
      <div class="hidden lg:block absolute inset-0 pointer-events-none">
        <svg class="w-full h-full" viewBox="0 0 1000 500" fill="none" preserveAspectRatio="none">
          <line x1="250" y1="150" x2="480" y2="250" stroke="rgba(245,158,11,0.1)" stroke-width="1" stroke-dasharray="4 4" />
          <line x1="750" y1="150" x2="520" y2="250" stroke="rgba(245,158,11,0.1)" stroke-width="1" stroke-dasharray="4 4" />
          <line x1="250" y1="350" x2="480" y2="250" stroke="rgba(245,158,11,0.1)" stroke-width="1" stroke-dasharray="4 4" />
          <line x1="750" y1="350" x2="520" y2="250" stroke="rgba(245,158,11,0.1)" stroke-width="1" stroke-dasharray="4 4" />
        </svg>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 lg:gap-x-32 lg:gap-y-8">
        {components.map((comp, i) => (
          <div
            class="card-hover p-6 reveal group"
            style={`transition-delay: ${i * 100}ms`}
          >
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 rounded-xl bg-accent/8 border border-accent/15 flex items-center justify-center text-accent shrink-0 group-hover:bg-accent/12 group-hover:border-accent/25 transition-all">
                <Fragment set:html={comp.icon} />
              </div>
              <div>
                <div class="flex items-baseline gap-3 mb-1.5">
                  <h3 class="font-body font-semibold text-text-primary text-lg">{comp.name}</h3>
                  <span class="text-[11px] font-mono text-text-tertiary">{comp.tech}</span>
                </div>
                <p class="text-sm text-text-secondary leading-relaxed">{comp.description}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
