  },
  {
    title: 'Notifications',
    description: 'Slack, Discord, Google Chat, webhooks with HMAC-SHA256, and email via SMTP. Stay informed on every deploy.',
    icon: `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M14.857 17.082a23.848 23.848 0 005.454-1.31A8.967 8.967 0 0118 9.75v-.7V9A6 6 0 006 9v.75a8.967 8.967 0 01-2.312 6.022c1.733.64 3.56 1.085 5.455 1.31m5.714 0a24.255 24.255 0 01-5.714 0m5.714 0a3 3 0 11-5.714 0" /></svg>`,
    span: 'col-span-1',
  },
];
---

<section class="relative py-24 lg:py-32" id="features">
  <div class="max-w-6xl mx-auto px-6">
    <div class="text-center mb-16 reveal">
      <span class="text-[11px] font-mono font-semibold text-accent uppercase tracking-[0.15em] mb-4 block">Features</span>
      <h2 class="font-display italic text-4xl md:text-5xl text-text-primary mb-4">
        Everything you need to ship.
      </h2>
      <p class="text-text-secondary text-lg max-w-2xl mx-auto">
        A complete platform built on Kubernetes primitives. No vendor lock-in, no hidden complexity.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      {features.map((feature, i) => (
        <div
          class:list={[
            'card-hover p-6 group reveal',
            feature.span,
          ]}
          style={`transition-delay: ${i * 80}ms`}
        >
          <div class="w-10 h-10 rounded-lg bg-accent/8 border border-accent/15 flex items-center justify-center text-accent mb-4 group-hover:bg-accent/12 group-hover:border-accent/25 transition-all">
            <Fragment set:html={feature.icon} />
          </div>
          <h3 class="font-body font-semibold text-text-primary text-lg mb-2">{feature.title}</h3>
          <p class="text-sm text-text-secondary leading-relaxed">{feature.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
