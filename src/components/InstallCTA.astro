---
const installCommand = `helm install vesta oci://ghcr.io/vesta-infra/charts/vesta \\
  -n vesta-system --create-namespace`;
---

<section class="relative py-24 lg:py-32">
  <div class="max-w-3xl mx-auto px-6">
    <div class="relative reveal">
      <!-- Ambient glow -->
      <div class="absolute -inset-8 bg-gradient-radial from-accent/6 to-transparent rounded-3xl blur-2xl"></div>

      <div class="relative card gradient-border p-10 md:p-14 text-center">
        <h2 class="font-display italic text-3xl md:text-4xl text-text-primary mb-4">
          Ready to deploy?
        </h2>
        <p class="text-text-secondary mb-8 max-w-lg mx-auto">
          Install Vesta on your cluster in under a minute. No credit card, no sign-up — it's open source.
        </p>

        <!-- Install command -->
        <div class="relative rounded-lg border border-border bg-surface-1/90 overflow-hidden text-left mb-8 group">
          <div class="flex items-center justify-between px-4 py-2 border-b border-border/50 bg-surface-2/30">
            <span class="text-[11px] font-mono text-text-tertiary">terminal</span>
            <button
              class="copy-btn text-[11px] font-mono text-text-tertiary hover:text-accent transition-colors"
              data-code={installCommand}
              id="cta-copy-btn"
            >
              copy
            </button>
          </div>
          <pre class="p-4 overflow-x-auto"><code class="font-mono text-[13px] text-text-primary leading-relaxed">{installCommand}</code></pre>
        </div>

        <div class="flex flex-wrap items-center justify-center gap-4">
          <a href="/docs/getting-started" class="btn-primary">
            Read the Docs
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
            </svg>
          </a>
          <a href="https://github.com/vesta-infra/vesta-kubernetes" target="_blank" rel="noopener noreferrer" class="btn-ghost">
            <svg class="w-4 h-4" viewBox="0 0 16 16" fill="currentColor">
              <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z" />
            </svg>
            Star on GitHub
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
