---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404 — Page Not Found">
  <div class="pt-16 min-h-[80vh] flex items-center justify-center">
    <div class="text-center px-6">
      <div class="relative inline-block mb-8">
        <span class="font-display italic text-[120px] md:text-[180px] text-surface-3 leading-none select-none">404</span>
        <div class="absolute inset-0 flex items-center justify-center">
          <div class="w-20 h-20 rounded-2xl bg-surface-2 border border-accent/20 flex items-center justify-center shadow-glow">
            <div class="w-6 h-6 rounded bg-accent shadow-[0_0_20px_rgba(245,158,11,0.5)]"></div>
          </div>
        </div>
      </div>
      <h1 class="font-display italic text-3xl text-text-primary mb-3">Page not found</h1>
      <p class="text-text-secondary mb-8 max-w-md mx-auto">
        The page you're looking for doesn't exist or has been moved.
      </p>
      <div class="flex items-center justify-center gap-4">
        <a href="/" class="btn-primary">
          Go Home
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
          </svg>
        </a>
        <a href="/docs/getting-started" class="btn-ghost">
          Read Docs
        </a>
      </div>
    </div>
  </div>
</BaseLayout>
