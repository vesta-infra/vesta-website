---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);
---

<BaseLayout title="Blog — Vesta" description="News, updates, and guides from the Vesta team.">
  <div class="pt-16">
    <section class="py-24 lg:py-32">
      <div class="max-w-4xl mx-auto px-6">
        <div class="text-center mb-16">
          <span class="text-[11px] font-mono font-semibold text-accent uppercase tracking-[0.15em] mb-4 block animate-fade-in">Blog</span>
          <h1 class="font-display italic text-5xl text-text-primary animate-slide-up">
            News & Updates
          </h1>
          <a
            href="/rss.xml"
            class="mt-5 inline-flex items-center gap-2 text-sm text-text-secondary hover:text-accent transition-colors"
          >
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M6.18 15.64a2.18 2.18 0 012.18 2.18C8.36 19 7.38 20 6.18 20 5 20 4 19 4 17.82a2.18 2.18 0 012.18-2.18zM4 4.44A15.56 15.56 0 0119.56 20h-2.83A12.73 12.73 0 004 7.27V4.44zm0 5.66a9.9 9.9 0 019.9 9.9h-2.83A7.07 7.07 0 004 12.93V10.1z" />
            </svg>
            Subscribe via RSS
          </a>
        </div>

        {posts.length === 0 ? (
          <p class="text-center text-text-secondary">No posts yet. Check back soon.</p>
        ) : (
          <div class="grid gap-6">
            {posts.map((post, i) => (
              <a
                href={`/blog/${post.slug}`}
                class="card-hover p-6 md:p-8 block group reveal"
                style={`transition-delay: ${i * 80}ms`}
              >
                <div class="flex items-center gap-3 mb-3">
                  <time class="text-[11px] font-mono text-text-tertiary uppercase tracking-wider">
                    {post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
                  </time>
                  <span class="text-text-tertiary">·</span>
                  <span class="text-[11px] font-mono text-text-tertiary">{post.data.author}</span>
                </div>
                <h2 class="font-display italic text-2xl text-text-primary group-hover:text-accent transition-colors mb-2">
                  {post.data.title}
                </h2>
                <p class="text-sm text-text-secondary leading-relaxed">
                  {post.data.description}
                </p>
              </a>
            ))}
          </div>
        )}
      </div>
    </section>
  </div>
</BaseLayout>
